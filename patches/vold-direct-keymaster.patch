+using V4_1_ErrorCode = ::android::hardware::keymaster::V4_1::ErrorCode;
+}  // namespace km
+
+using KmDevice = km::support::Keymaster;
+
+// Wrapper for a Keymaster operation handle representing an ongoing
+// Keymaster operation. Aborts the operation in the destructor if it is
+// unfinished. The hardware auth token used to start the operation is
+// forwarded to update and finish, which is required for auth-per-use keys.
+class HidlKeymasterOperation {
+  public:
+    ~HidlKeymasterOperation();
+    // Is this instance valid? This is false if creation fails, and becomes
+    // false on finish or if an update fails.
+    explicit operator bool() const { return mError == km::ErrorCode::OK; }
+    km::ErrorCode errorCode() const { return mError; }
+    // Call "update" repeatedly until all of the input is consumed, and
+    // concatenate the output. Return true on success.
+    template <class TI, class TO>
+    bool updateCompletely(TI& input, TO* output) {
+        if (output) output->clear();
+        return updateCompletely(input.data(), input.size(), [&](const char* b, size_t n) {
+            if (output) std::copy(b, b + n, std::back_inserter(*output));
+        });
+    }
+
+    // Finish and write the output to this string, unless pointer is null.
+    bool finish(std::string* output);
+    // Move constructor
+    HidlKeymasterOperation(HidlKeymasterOperation&& rhs) { *this = std::move(rhs); }
+    // Construct an object in an error state for error returns
+    HidlKeymasterOperation()
+        : mDevice{nullptr}, mOpHandle{0}, mAuthToken{}, mError{km::ErrorCode::UNKNOWN_ERROR} {}
+    // Move Assignment
+    HidlKeymasterOperation& operator=(HidlKeymasterOperation&& rhs) {
+        mDevice = rhs.mDevice;
+        rhs.mDevice = nullptr;
+
+        mOpHandle = rhs.mOpHandle;
+        rhs.mOpHandle = 0;
+
+        mAuthToken = std::move(rhs.mAuthToken);
+        rhs.mAuthToken = km::HardwareAuthToken();
+
+        mError = rhs.mError;
+        rhs.mError = km::ErrorCode::UNKNOWN_ERROR;
+
+        return *this;
+    }
+
+  private:
+    HidlKeymasterOperation(KmDevice* d, uint64_t h, const km::HardwareAuthToken& authToken)
+        : mDevice{d}, mOpHandle{h}, mAuthToken{authToken}, mError{km::ErrorCode::OK} {}
+    HidlKeymasterOperation(km::ErrorCode error)
+        : mDevice{nullptr}, mOpHandle{0}, mAuthToken{}, mError{error} {}
+
+    bool updateCompletely(const char* input, size_t inputLen,
+                          const std::function<void(const char*, size_t)> consumer);
+
+    KmDevice* mDevice;
+    uint64_t mOpHandle;
+    km::HardwareAuthToken mAuthToken;
+    km::ErrorCode mError;
+    DISALLOW_COPY_AND_ASSIGN(HidlKeymasterOperation);
+    friend class HidlKeymaster;
+};
+
+// Wrapper for a Keymaster HIDL device, used to decrypt blobs stored by the
+// legacy keystore daemon without going through keystore/keystore2.
+class HidlKeymaster {
+  public:
+    HidlKeymaster();
+    // false if we failed to open the keymaster device.
+    explicit operator bool() { return mDevice.get() != nullptr; }
+    // Begin a new cryptographic operation, collecting output parameters if pointer is non-null
+    HidlKeymasterOperation begin(km::KeyPurpose purpose, const std::string& key,
+                                 const km::AuthorizationSet& inParams,
+                                 const km::HardwareAuthToken& authToken,
+                                 km::AuthorizationSet* outParams);
+
+  private:
+    sp<KmDevice> mDevice;
+    DISALLOW_COPY_AND_ASSIGN(HidlKeymaster);
+};
+
+}  // namespace hidl_km
